{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cairn/schemas/plugin.schema.json",
  "title": "Plugin Manifest",
  "description": "Schema for Cairn plugin.json manifests",
  "type": "object",
  "required": ["name", "version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64,
      "description": "Kebab-case plugin identifier"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
      "description": "Semantic version"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Short description of the plugin"
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        },
        "email": {
          "type": "string",
          "description": "Author contact email"
        }
      },
      "description": "Plugin author"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Search keywords"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier"
    },
    "homepage": {
      "type": "string",
      "description": "Plugin homepage URL"
    },
    "repository": {
      "type": "string",
      "description": "Source repository URL"
    }
  }
}
