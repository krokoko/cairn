{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonomy-rails/schemas/marketplace.schema.json",
  "title": "Marketplace Registry",
  "description": "Schema for the autonomy-rails plugin marketplace registry",
  "type": "object",
  "required": ["name", "version", "plugins"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Marketplace name"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
      "description": "Marketplace version"
    },
    "description": {
      "type": "string",
      "description": "Marketplace description"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "version", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "description": "Relative path to the plugin directory"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$"
          },
          "description": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
