{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cairn/schemas/marketplace.schema.json",
  "title": "Marketplace Registry",
  "description": "Schema for the Cairn plugin marketplace registry",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Marketplace description"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
          "description": "Marketplace version"
        }
      }
    },
    "name": {
      "type": "string",
      "description": "Marketplace name"
    },
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Owner name"
        },
        "email": {
          "type": "string",
          "description": "Owner contact email"
        },
        "url": {
          "type": "string",
          "description": "Owner homepage URL"
        }
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source", "description"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "source": {
            "type": "string",
            "description": "Relative path to the plugin directory (e.g. ./plugins/my-plugin)"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
